{
  "openapi": "3.0.3",
  "info": {
    "title": "Book Recommender API",
    "description": "Semantic book recommendations with optional category and emotion or tone filters.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health checks"
    },
    {
      "name": "Recommendations",
      "description": "Semantic book search and ranking"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check API health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The API is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {"status": "ok"}
              }
            }
          }
        }
      }
    },
    "/api/recommendations": {
      "post": {
        "tags": ["Recommendations"],
        "summary": "Get book recommendations",
        "description": "Searches for books similar to the query and optionally filters or ranks them by category and emotion or tone. The response contains at most 240 recommendations.",
        "operationId": "createRecommendations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              },
              "example": {
                "query": "a hopeful story about starting over",
                "category": "Fiction",
                "emotion": "Joy",
                "top_k": 250
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recommendations were generated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid JSON or contains invalid fields.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"},
                "example": {"error": {"message": "'query' is required and must be a non-empty string."}}
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"},
                "example": {"error": {"message": "An unexpected error occurred."}}
              }
            }
          },
          "503": {
            "description": "A recommendation dependency is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"},
                "example": {"error": {"message": "Recommendations are temporarily unavailable."}}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"type": "string", "enum": ["ok"]}
        }
      },
      "RecommendationRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Text used to find semantically similar books. Whitespace-only values are rejected."
          },
          "category": {
            "type": "string",
            "default": "All",
            "enum": ["All", "Fiction", "Nonfiction", "Children's Fiction", "Children's Nonfiction"]
          },
          "emotion": {
            "type": "string",
            "default": "All",
            "enum": ["All", "Anger", "Disgust", "Fear", "Joy", "Sadness", "Surprise", "Neutral", "Happy", "Surprising", "Angry", "Suspenseful", "Sad"]
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 250,
            "default": 250,
            "description": "Maximum number of nearest books to retrieve before filtering and ranking."
          }
        }
      },
      "RecommendationResponse": {
        "type": "object",
        "required": ["recommendations", "total"],
        "properties": {
          "recommendations": {
            "type": "array",
            "maxItems": 240,
            "items": {"$ref": "#/components/schemas/BookRecommendation"}
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of returned recommendations."
          }
        }
      },
      "BookRecommendation": {
        "type": "object",
        "required": ["isbn13", "title_and_subtitle", "authors", "thumbnail", "description", "simple_categories", "published_year", "average_rating", "anger", "disgust", "fear", "joy", "sadness", "surprise", "neutral", "similarity_score"],
        "properties": {
          "isbn13": {"type": "string", "nullable": true},
          "title_and_subtitle": {"type": "string", "nullable": true},
          "authors": {"type": "string", "nullable": true},
          "thumbnail": {"type": "string", "nullable": true},
          "description": {"type": "string", "nullable": true},
          "simple_categories": {"type": "string", "nullable": true},
          "published_year": {"type": "integer", "nullable": true},
          "average_rating": {"type": "number", "format": "float", "nullable": true},
          "anger": {"type": "number", "format": "float", "nullable": true},
          "disgust": {"type": "number", "format": "float", "nullable": true},
          "fear": {"type": "number", "format": "float", "nullable": true},
          "joy": {"type": "number", "format": "float", "nullable": true},
          "sadness": {"type": "number", "format": "float", "nullable": true},
          "surprise": {"type": "number", "format": "float", "nullable": true},
          "neutral": {"type": "number", "format": "float", "nullable": true},
          "similarity_score": {"type": "number", "format": "float"}
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["message"],
            "properties": {
              "message": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
