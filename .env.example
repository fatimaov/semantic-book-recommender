# Flask runtime settings are separate from APP_ENV.
SECRET_KEY=replace-with-a-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=true

# Base URL used by the Gradio frontend to reach the Flask API.
FLASK_API_URL=http://127.0.0.1:5000

# Select the application stack: local uses Hugging Face embeddings and local
# Chroma; production uses Gemini embeddings and the Supabase PostgreSQL database.
APP_ENV=local

# Local Chroma database location and collection.
CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_COLLECTION_NAME=books

# Production Gemini credentials and embedding model.
GOOGLE_API_KEY=your-google-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Production Supabase PostgreSQL connection string from Project Settings > Database.
SUPABASE_DATABASE_URL=postgresql://postgres:your-password@db.<project-ref>.supabase.co:5432/postgres
